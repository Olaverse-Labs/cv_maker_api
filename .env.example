OPENROUTER_API_KEY=your_openrouter_api_key_here
GOTENBERG_URL=http://localhost:3000
GOTENBERG_USERNAME=
GOTENBERG_PASSWORD=

# Seconds to wait for a model response before giving up (default 120)
OPENROUTER_TIMEOUT=120

# Shown in OpenRouter's dashboard rankings; both optional
APP_URL=
APP_TITLE=CV Maker API

# Largest accepted upload per file, in megabytes (default 10)
MAX_UPLOAD_MB=10

# Comma-separated allowed origins, or * for any (default *)
CORS_ALLOW_ORIGINS=*

# DEBUG, INFO, WARNING, ERROR (default INFO)
LOG_LEVEL=INFO
